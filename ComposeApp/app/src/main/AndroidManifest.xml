<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 宿舍开门可选门闸：开门前验证指纹/面容（API 28+ 平台 BiometricPrompt） -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 教务网页导入：内嵌浏览器加载用户选择的教务网站与适配器仓库下载 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 校园页（云莓宿舍开门）：蓝牙扫描与连接；定位权限仅 Android 11 及以下的 BLE 扫描需要 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- 同步课程到系统日历（只写专属「不挂科课表」本地日历） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 操作触感反馈（普通权限，无需运行时申请） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 开机后重排课前提醒 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 精确闹钟：USE_EXACT_ALARM 在 API 33+ 自动授予（课表提醒为应用核心功能）；
         API 31/32 由 SCHEDULE_EXACT_ALARM 覆盖（默认授予）；API 30- 本就允许精确闹钟。
         授予后走 setExactAndAllowWhileIdle 准点触发，不再依赖窗口闹钟降级。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 洗衣房「附近门店」（可选）：仅在你点「附近门店」时取一次大致位置列出附近门店；
         拒绝授权不影响任何功能（退化为门店名搜索），不后台采集、不留存轨迹 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 快捷方式 Intent 的解析目标：长按应用图标 → 快速开锁（宿舍门） -->
            <intent-filter>
                <action android:name="com.buguake.timetable.campus.UNLOCK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 今日课程桌面小组件（4×2 双栏：左今 / 右明） -->
        <receiver
            android:name=".widget.ScheduleWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info_2x4" />
        </receiver>

        <!-- 今日课程桌面小组件（3×2 列表） -->
        <receiver
            android:name=".widget.ScheduleWidgetMediumProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info_3x2" />
        </receiver>

        <!-- 今日课程桌面小组件（2×2 紧凑） -->
        <receiver
            android:name=".widget.ScheduleWidgetCompactProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info_2x2" />
        </receiver>

        <!-- 洗衣房 2×2 小组件：展示上次浏览楼栋的空闲洗衣机/烘干机数（数据随应用内刷新更新，组件自身不联网） -->
        <receiver
            android:name=".widget.LaundryWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/laundry_widget_info" />
        </receiver>

        <!-- 小组件列表数据源（仅系统绑定） -->
        <service
            android:name=".widget.ScheduleWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 课表分享图：授权系统分享面板读取 cache/share 下的 PNG -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 课前提醒：闹钟触发 + 开机重排 -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
