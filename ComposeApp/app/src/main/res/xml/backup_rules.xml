<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 以下的全量备份 / 设备迁移规则。
  排除 campus_prefs.xml：其中保存云莓账号、密码摘要与门锁密钥（Keystore 加密）；
  这类凭据不应进入云端备份或被迁移到其他设备，重新登录一次即可。
  课表数据库继续参与备份，方便换机保留课表。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="campus_prefs.xml" />
    <!-- 适配脚本缓存可随时重新下载，排除以缩小备份体积 -->
    <exclude domain="file" path="webimport" />
</full-backup-content>
